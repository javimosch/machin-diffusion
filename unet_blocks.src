// unet_blocks.src — ResNet block, Transformer block, Attention for UNet
// SD-Turbo UNet: ResNet blocks (GroupNorm+SiLU+Conv2d+time_emb),
//   spatial self-attention (attn1), cross-attention with CLIP (attn2),
//   FeedForward (GeGLU).

// ---- ResNet block ----
// Tensor names: {prefix}.norm1.{weight,bias}, {prefix}.conv1.{weight,bias},
//   {prefix}.time_emb_proj.{weight,bias}, {prefix}.norm2.{weight,bias},
//   {prefix}.conv2.{weight,bias}
// Flow: norm1→SiLU→conv1→+time_emb→norm2→SiLU→conv2→+residual
// channels: block channel count, h/w: spatial dims
// temb: [1280] time embedding (already SiLU'd? no — we apply SiLU to temb here)
func resnet_block(out, in_buf, prefix, channels, h, w_dim, temb, temb_dim) {
    resnet_block_ch(out, in_buf, prefix, channels, channels, h, w_dim, temb, temb_dim)
}

// ResNet block with potentially different in/out channels (for down block first resnet)
func resnet_block_ch(out, in_buf, prefix, in_ch, out_ch, h, w_dim, temb, temb_dim) {
    // Ensure in_buf is on host (needed for residual axpy later)
    ocl_sync()
    tmp := alloc(in_ch * h * w_dim * 4)

    // norm1 + SiLU (fused GPU kernel)
    w_n1w, _ := st_tensor(prefix + ".norm1.weight")
    w_n1b, _ := st_tensor(prefix + ".norm1.bias")
    group_norm_silu_f32(tmp, in_buf, w_n1w, w_n1b, in_ch, h, w_dim, 32, 0.00001)

    // conv1: in_ch → out_ch (3×3, pad=1)
    w_c1w, _ := st_tensor(prefix + ".conv1.weight")
    w_c1b, _ := st_tensor(prefix + ".conv1.bias")
    conv2d(out, tmp, w_c1w, w_c1b, in_ch, out_ch, h, w_dim, 3, 3, 1, 1)
    free(tmp)

    // Add time embedding projection
    w_tepw, _ := st_tensor(prefix + ".time_emb_proj.weight")
    w_tepb, _ := st_tensor(prefix + ".time_emb_proj.bias")
    temb_proj := alloc(out_ch * 4)
    temb_silu := alloc(temb_dim * 4)
    copy_buf(temb_silu, temb, temb_dim)
    silu_buf(temb_silu, temb_dim)
    linear(temb_proj, w_tepw, w_tepb, temb_silu, temb_dim, out_ch)
    free(temb_silu)

    // Add temb_proj to each spatial position (GPU broadcast add)
    add_vec_spatial_f32(out, temb_proj, out_ch, h * w_dim)
    free(temb_proj)

    // norm2 + SiLU (fused GPU kernel)
    tmp2 := alloc(out_ch * h * w_dim * 4)
    w_n2w, _ := st_tensor(prefix + ".norm2.weight")
    w_n2b, _ := st_tensor(prefix + ".norm2.bias")
    group_norm_silu_f32(tmp2, out, w_n2w, w_n2b, out_ch, h, w_dim, 32, 0.00001)

    // conv2: out_ch → out_ch
    w_c2w, _ := st_tensor(prefix + ".conv2.weight")
    w_c2b, _ := st_tensor(prefix + ".conv2.bias")
    conv2d(out, tmp2, w_c2w, w_c2b, out_ch, out_ch, h, w_dim, 3, 3, 1, 1)
    free(tmp2)

    // Residual: need conv_shortcut if in_ch != out_ch — use axpy_f32 (vectorized)
    if in_ch != out_ch {
        w_sc_w, _ := st_tensor(prefix + ".conv_shortcut.weight")
        w_sc_b, _ := st_tensor(prefix + ".conv_shortcut.bias")
        shortcut := alloc(out_ch * h * w_dim * 4)
        conv2d(shortcut, in_buf, w_sc_w, w_sc_b, in_ch, out_ch, h, w_dim, 1, 1, 0, 1)
        axpy_f32(out, 1.0, shortcut, out_ch * h * w_dim)
        free(shortcut)
    } else {
        axpy_f32(out, 1.0, in_buf, out_ch * h * w_dim)
    }
}

// ---- Spatial attention (self or cross) ----
// For self-attention (attn1): qkv all from hidden_states
// For cross-attention (attn2): q from hidden_states, kv from context (CLIP embeddings)
//
// Tensor names: {prefix}.to_q.weight, .to_k.weight, .to_v.weight,
//   .to_out.0.weight, .to_out.0.bias
// (No bias on q/k/v, only on out)
//
// hidden_states: [H*W, channels] (reshaped from [C, H, W] → [H*W, C])
// context: [seq, cross_dim] for cross-attn, or hidden_states for self-attn
// heads: number of attention heads, head_dim = channels / heads
func spatial_attention(out, hidden_states, context, prefix, seq, channels, ctx_dim, heads) {
    head_dim := channels / heads
    scale := 1.0 / sqrt(float(head_dim))
    // For self-attention: ctx_seq == seq, context == hidden_states
    // For cross-attention: ctx_seq == 77 (CLIP), seq == H*W (spatial)
    // We need ctx_seq to size K/V correctly. For self-attn, ctx_seq = seq.
    // The caller passes context; we infer ctx_seq from whether ctx_dim == channels
    // and context == hidden_states (self) or not (cross).
    // Actually, we need ctx_seq passed in. Let's add it as a parameter.
    // For now, infer: if ctx_dim == channels, assume self-attn (ctx_seq = seq).
    // If ctx_dim != channels, it's cross-attn with 77 CLIP tokens.
    // This is fragile — let's just add a ctx_seq parameter.
    ctx_seq := seq
    if ctx_dim != channels { ctx_seq = 77 }  // CLIP context length

    // Load Q/K/V weights
    w_q, _ := st_tensor(prefix + ".to_q.weight")
    w_k, _ := st_tensor(prefix + ".to_k.weight")
    w_v, _ := st_tensor(prefix + ".to_v.weight")
    w_out, _ := st_tensor(prefix + ".to_out.0.weight")
    b_out, _ := st_tensor(prefix + ".to_out.0.bias")

    // Q = hidden_states @ to_q.weight^T  → [seq, channels]
    q := alloc(seq * channels * 4)
    // K = context @ to_k.weight^T  → [ctx_seq, channels]
    k := alloc(ctx_seq * channels * 4)
    // V = context @ to_v.weight^T  → [ctx_seq, channels]
    v := alloc(ctx_seq * channels * 4)

    // Compute Q — batched matmul (all query positions at once)
    matmul_f32(q, hidden_states, w_q, 0, channels, channels, seq)
    // Compute K, V — batched matmul (all context positions at once)
    matmul_f32(k, context, w_k, 0, ctx_dim, channels, ctx_seq)
    matmul_f32(v, context, w_v, 0, ctx_dim, channels, ctx_seq)

    // Multi-head attention — fused GPU kernel (flash-attention-lite)
    attn_out := alloc(seq * channels * 4)
    zero_buf(attn_out, seq * channels)

    scale := 1.0 / sqrt(float(head_dim))
    attention_f32(q, k, v, attn_out, seq, ctx_seq, channels, heads, scale)

    // Output projection: batched matmul (all positions at once)
    matmul_f32(out, attn_out, w_out, b_out, channels, channels, seq)

    free(q)
    free(k)
    free(v)
    free(attn_out)
}

// ---- Transformer block (used in UNet attention) ----
// Tensor names: {prefix}.norm1.{weight,bias}, .norm2.{weight,bias}, .norm3.{weight,bias}
//   .attn1.to_q.weight, .attn1.to_k.weight, .attn1.to_v.weight, .attn1.to_out.0.{weight,bias}
//   .attn2.to_q.weight, .attn2.to_k.weight, .attn2.to_v.weight, .attn2.to_out.0.{weight,bias}
//   .ff.net.0.proj.{weight,bias}, .ff.net.2.{weight,bias}
//
// Flow:
//   h = x + attn1(norm1(x))           — self-attention
//   h = h + attn2(norm2(h), context)  — cross-attention
//   h = h + ff(norm3(h))              — feed-forward (GeGLU)
//
// hidden_states: [seq, channels], context: [ctx_seq, cross_dim]
func transformer_block(out, hidden_states, context, prefix, seq, channels, ctx_seq, cross_dim, heads) {
    // Ensure hidden_states is on host (needed for residual)
    ocl_sync()

    // norm1 (GPU layer_norm_batch — chains with previous if possible)
    w_n1w, _ := st_tensor(prefix + ".norm1.weight")
    w_n1b, _ := st_tensor(prefix + ".norm1.bias")
    norm1_out := alloc(seq * channels * 4)
    if norm1_out == 0 { println(" alloc failed norm1")  exit(1) }
    layer_norm_batch_f32(norm1_out, hidden_states, w_n1w, w_n1b, seq, channels)

    // attn1 (self-attention) — chains with norm1_out on device
    attn1_out := alloc(seq * channels * 4)
    if attn1_out == 0 { println(" alloc failed attn1")  exit(1) }
    spatial_attention(attn1_out, norm1_out, norm1_out, prefix + ".attn1", seq, channels, channels, heads)
    free(norm1_out)

    // h = hidden_states + attn1_out — sync attn1_out to host, then axpy (GPU)
    ocl_sync()
    h := alloc(seq * channels * 4)
    copy_buf(h, hidden_states, seq * channels)
    axpy_f32(h, 1.0, attn1_out, seq * channels)
    free(attn1_out)

    // norm2 (GPU) — chains with h on device
    w_n2w, _ := st_tensor(prefix + ".norm2.weight")
    w_n2b, _ := st_tensor(prefix + ".norm2.bias")
    norm2_out := alloc(seq * channels * 4)
    layer_norm_batch_f32(norm2_out, h, w_n2w, w_n2b, seq, channels)

    // attn2 (cross-attention) — chains with norm2_out
    attn2_out := alloc(seq * channels * 4)
    spatial_attention(attn2_out, norm2_out, context, prefix + ".attn2", seq, channels, cross_dim, heads)
    free(norm2_out)

    // h = h + attn2_out — sync attn2_out, axpy takes h from device
    ocl_sync()
    axpy_f32(h, 1.0, attn2_out, seq * channels)
    free(attn2_out)

    // norm3 (GPU) — chains with h
    w_n3w, _ := st_tensor(prefix + ".norm3.weight")
    w_n3b, _ := st_tensor(prefix + ".norm3.bias")
    norm3_out := alloc(seq * channels * 4)
    layer_norm_batch_f32(norm3_out, h, w_n3w, w_n3b, seq, channels)

    // FeedForward: GeGLU — all GPU, chains through
    w_ff1w, _ := st_tensor(prefix + ".ff.net.0.proj.weight")
    w_ff1b, _ := st_tensor(prefix + ".ff.net.0.proj.bias")
    w_ff2w, _ := st_tensor(prefix + ".ff.net.2.weight")
    w_ff2b, _ := st_tensor(prefix + ".ff.net.2.bias")

    ff1_shape := st_shape(prefix + ".ff.net.0.proj.weight")
    inner2 := ff1_shape[0]
    inner := inner2 / 2

    ff_hidden := alloc(seq * inner2 * 4)
    ff_gated := alloc(seq * inner * 4)
    matmul_f32(ff_hidden, norm3_out, w_ff1w, w_ff1b, channels, inner2, seq)
    free(norm3_out)
    geglu_f32(ff_gated, ff_hidden, inner, seq)
    free(ff_hidden)
    matmul_f32(out, ff_gated, w_ff2w, w_ff2b, inner, channels, seq)
    free(ff_gated)

    // h = h + ff_out — sync out, then axpy with h
    ocl_sync()
    axpy_f32(out, 1.0, h, seq * channels)
    free(h)
}

// ---- Attention block (UNet spatial attention with GroupNorm + proj_in/out) ----
// Tensor names: {prefix}.norm.{weight,bias} (GroupNorm),
//   .proj_in.{weight,bias} (Linear), .proj_out.{weight,bias} (Linear),
//   .transformer_blocks.0.{norm1,norm2,norm3,attn1,attn2,ff...}
//
// input: [C, H, W] → reshape to [H*W, C] → attention → reshape back → residual
// use_linear_projection: true (proj_in/out are Linear, not Conv2d)
func attention_block(out, in_buf, context, prefix, channels, h, w_dim, ctx_seq, cross_dim, heads) {
    seq := h * w_dim

    // Ensure in_buf is on host (needed as residual for transpose_add at the end)
    ocl_sync()

    // GroupNorm
    w_gn_w, _ := st_tensor(prefix + ".norm.weight")
    w_gn_b, _ := st_tensor(prefix + ".norm.bias")
    normed := alloc(channels * h * w_dim * 4)
    group_norm(normed, in_buf, w_gn_w, w_gn_b, channels, h, w_dim, 32, 0.00001)

    // Reshape [C, H, W] → [H*W, C] (transpose) — GPU builtin
    hs := alloc(seq * channels * 4)
    transpose_chw_f32(hs, normed, channels, h, w_dim)
    free(normed)

    // proj_in (batched Linear: channels → channels for all seq positions)
    w_pin_w, _ := st_tensor(prefix + ".proj_in.weight")
    w_pin_b, _ := st_tensor(prefix + ".proj_in.bias")
    proj_in_out := alloc(seq * channels * 4)
    matmul_f32(proj_in_out, hs, w_pin_w, w_pin_b, channels, channels, seq)
    free(hs)

    // Transformer block (only 1 layer per block for SD-Turbo)
    tb_out := alloc(seq * channels * 4)
    transformer_block(tb_out, proj_in_out, context, prefix + ".transformer_blocks.0", seq, channels, ctx_seq, cross_dim, heads)
    free(proj_in_out)

    // proj_out (batched Linear: channels → channels for all seq positions)
    w_pout_w, _ := st_tensor(prefix + ".proj_out.weight")
    w_pout_b, _ := st_tensor(prefix + ".proj_out.bias")
    proj_out_out := alloc(seq * channels * 4)
    matmul_f32(proj_out_out, tb_out, w_pout_w, w_pout_b, channels, channels, seq)
    free(tb_out)

    // Reshape [H*W, C] → [C, H, W] (transpose back) and add residual — GPU builtin
    transpose_add_chw_f32(out, in_buf, proj_out_out, channels, h, w_dim)
    free(proj_out_out)
}
