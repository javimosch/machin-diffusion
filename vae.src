// vae.src — VAE decoder for SD-Turbo
// Decodes latent [4, 64, 64] → image [3, 512, 512]
// Architecture: post_quant_conv → conv_in → mid_block (resnet+attn+resnet)
//   → 4 up_blocks (3 with upsamplers) → conv_norm_out → conv_out

// VAE decoder config
var vae_channels = []int{512, 512, 256, 128}  // up block output channels

// Simple self-attention for VAE mid_block (single-head, with bias on QKV)
func vae_attention(out, in_buf, prefix, channels, h, w_dim) {
    seq := h * w_dim

    // Ensure in_buf is on host (needed for residual at end)
    ocl_sync()

    // GroupNorm
    w_gn_w, _ := st_tensor(prefix + ".group_norm.weight")
    w_gn_b, _ := st_tensor(prefix + ".group_norm.bias")
    normed := alloc(channels * h * w_dim * 4)
    group_norm(normed, in_buf, w_gn_w, w_gn_b, channels, h, w_dim, 32, 0.000001)

    // Reshape [C, H, W] → [H*W, C] — need normed on host
    ocl_sync()
    hs := alloc(seq * channels * 4)
    y := 0
    while y < h {
        x := 0
        while x < w_dim {
            pos := y * w_dim + x
            ci := 0
            while ci < channels {
                poke_f32(hs, (pos * channels + ci) * 4, peek_f32(normed, (ci * h * w_dim + y * w_dim + x) * 4))
                ci = ci + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    free(normed)

    // Q, K, V (with bias)
    w_q, _ := st_tensor(prefix + ".to_q.weight")
    b_q, _ := st_tensor(prefix + ".to_q.bias")
    w_k, _ := st_tensor(prefix + ".to_k.weight")
    b_k, _ := st_tensor(prefix + ".to_k.bias")
    w_v, _ := st_tensor(prefix + ".to_v.weight")
    b_v, _ := st_tensor(prefix + ".to_v.bias")

    q := alloc(seq * channels * 4)
    k := alloc(seq * channels * 4)
    v := alloc(seq * channels * 4)
    // Batched QKV projections
    matmul_f32(q, hs, w_q, b_q, channels, channels, seq)
    matmul_f32(k, hs, w_k, b_k, channels, channels, seq)
    matmul_f32(v, hs, w_v, b_v, channels, channels, seq)
    free(hs)

    // Single-head attention via 2x matmul_f32 (GPU) + softmax
    // head_dim=512 doesn't fit in registers, so use matmul decomposition
    scale := 1.0 / sqrt(float(channels))
    attn_out := alloc(seq * channels * 4)

    // scores = Q @ K^T  → [seq, seq]
    // matmul_f32(scores, q, k, 0, channels, seq, seq): scores[i,j] = dot(Q[i], K[j])
    scores := alloc(seq * seq * 4)
    matmul_f32(scores, q, k, 0, channels, seq, seq)

    // Softmax each row (scale + exp + normalize) — need scores on host
    ocl_sync()
    i := 0
    while i < seq {
        srow := scores + i * seq * 4
        mx := 0.0 - 1e30
        j := 0
        while j < seq {
            s := peek_f32(srow, j * 4) * scale
            if s > mx { mx = s }
            j = j + 1
        }
        sum := 0.0
        j = 0
        while j < seq {
            e := exp(peek_f32(srow, j * 4) * scale - mx)
            poke_f32(srow, j * 4, e)
            sum = sum + e
            j = j + 1
        }
        inv_sum := 1.0 / sum
        j = 0
        while j < seq {
            poke_f32(srow, j * 4, peek_f32(srow, j * 4) * inv_sum)
            j = j + 1
        }
        i = i + 1
    }

    // Transpose V: [seq, channels] → [channels, seq] for matmul — need v on host
    ocl_sync()
    v_t := alloc(channels * seq * 4)
    i = 0
    while i < seq {
        j := 0
        while j < channels {
            poke_f32(v_t, (j * seq + i) * 4, peek_f32(v, (i * channels + j) * 4))
            j = j + 1
        }
        i = i + 1
    }

    // attn_out = scores @ V  → [seq, channels]
    // matmul_f32(out, scores, v_t, 0, seq, channels, seq): out[i,c] = dot(scores[i], V[:,c])
    matmul_f32(attn_out, scores, v_t, 0, seq, channels, seq)

    free(q)
    free(k)
    free(v)
    free(scores)
    free(v_t)

    // Output projection (batched)
    w_out, _ := st_tensor(prefix + ".to_out.0.weight")
    b_out, _ := st_tensor(prefix + ".to_out.0.bias")
    proj_out := alloc(seq * channels * 4)
    matmul_f32(proj_out, attn_out, w_out, b_out, channels, channels, seq)
    free(attn_out)

    // Reshape back [H*W, C] → [C, H, W] and add residual — need proj_out and in_buf on host
    ocl_sync()
    y = 0
    while y < h {
        x = 0
        while x < w_dim {
            pos := y * w_dim + x
            ci = 0
            while ci < channels {
                idx := (ci * h * w_dim + y * w_dim + x) * 4
                poke_f32(out, idx, peek_f32(in_buf, idx) + peek_f32(proj_out, (pos * channels + ci) * 4))
                ci = ci + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    free(proj_out)
}

// VAE ResNet block (no time embedding, just norm→SiLU→conv→norm→SiLU→conv→residual)
func vae_resnet_block(out, in_buf, prefix, in_ch, out_ch, h, w_dim) {
    // Ensure in_buf is on host (needed for residual axpy)
    ocl_sync()
    tmp := alloc(in_ch * h * w_dim * 4)

    // norm1 + SiLU (fused GPU kernel)
    w_n1w, _ := st_tensor(prefix + ".norm1.weight")
    w_n1b, _ := st_tensor(prefix + ".norm1.bias")
    group_norm_silu_f32(tmp, in_buf, w_n1w, w_n1b, in_ch, h, w_dim, 32, 0.000001)

    // conv1: in_ch → out_ch
    w_c1w, _ := st_tensor(prefix + ".conv1.weight")
    w_c1b, _ := st_tensor(prefix + ".conv1.bias")
    conv2d(out, tmp, w_c1w, w_c1b, in_ch, out_ch, h, w_dim, 3, 3, 1, 1)
    free(tmp)

    // norm2 + SiLU (fused GPU kernel)
    tmp2 := alloc(out_ch * h * w_dim * 4)
    w_n2w, _ := st_tensor(prefix + ".norm2.weight")
    w_n2b, _ := st_tensor(prefix + ".norm2.bias")
    group_norm_silu_f32(tmp2, out, w_n2w, w_n2b, out_ch, h, w_dim, 32, 0.000001)

    // conv2: out_ch → out_ch
    w_c2w, _ := st_tensor(prefix + ".conv2.weight")
    w_c2b, _ := st_tensor(prefix + ".conv2.bias")
    conv2d(out, tmp2, w_c2w, w_c2b, out_ch, out_ch, h, w_dim, 3, 3, 1, 1)
    free(tmp2)

    // Residual (with shortcut if channels differ) — use axpy_f32 (vectorized)
    if in_ch != out_ch {
        w_sc_w, _ := st_tensor(prefix + ".conv_shortcut.weight")
        w_sc_b, _ := st_tensor(prefix + ".conv_shortcut.bias")
        shortcut := alloc(out_ch * h * w_dim * 4)
        conv2d(shortcut, in_buf, w_sc_w, w_sc_b, in_ch, out_ch, h, w_dim, 1, 1, 0, 1)
        axpy_f32(out, 1.0, shortcut, out_ch * h * w_dim)
        free(shortcut)
    } else {
        axpy_f32(out, 1.0, in_buf, out_ch * h * w_dim)
    }
}

// VAE decoder for SDXL (latent 128x128 → image 1024x1024)
func vae_decode_sdxl(latent) (image) {
    h := 128
    w := 128
    vt0 := now_ms()

    w_pqc_w, _ := st_tensor("post_quant_conv.weight")
    w_pqc_b, _ := st_tensor("post_quant_conv.bias")
    x := alloc(4 * h * w * 4)
    conv2d(x, latent, w_pqc_w, w_pqc_b, 4, 4, h, w, 1, 1, 0, 1)

    w_cin_w, _ := st_tensor("decoder.conv_in.weight")
    w_cin_b, _ := st_tensor("decoder.conv_in.bias")
    x2 := alloc(512 * h * w * 4)
    conv2d(x2, x, w_cin_w, w_cin_b, 4, 512, h, w, 3, 3, 1, 1)
    free(x)
    x = x2

    // mid_block
    mid0 := alloc(512 * h * w * 4)
    vae_resnet_block(mid0, x, "decoder.mid_block.resnets.0", 512, 512, h, w)
    free(x)
    x = mid0

    mid_att := alloc(512 * h * w * 4)
    vae_attention(mid_att, x, "decoder.mid_block.attentions.0", 512, h, w)
    free(x)
    x = mid_att

    mid1 := alloc(512 * h * w * 4)
    vae_resnet_block(mid1, x, "decoder.mid_block.resnets.1", 512, 512, h, w)
    free(x)
    x = mid1

    // up_blocks
    ub := 0
    while ub < 4 {
        out_ch := vae_channels[ub]
        in_ch := 0
        if ub == 0 { in_ch = 512 }
        if ub == 1 { in_ch = 512 }
        if ub == 2 { in_ch = 512 }
        if ub == 3 { in_ch = 256 }

        l := 0
        while l < 3 {
            r_in := in_ch
            if l > 0 { r_in = out_ch }
            res_out := alloc(out_ch * h * w * 4)
            vae_resnet_block(res_out, x, "decoder.up_blocks." + str(ub) + ".resnets." + str(l), r_in, out_ch, h, w)
            free(x)
            x = res_out
            l = l + 1
        }

        if ub < 3 {
            up_h := h * 2
            up_w := w * 2
            ocl_sync()
            upsampled := alloc(out_ch * up_h * up_w * 4)
            upsample_nearest(upsampled, x, out_ch, h, w)
            w_up_w, _ := st_tensor("decoder.up_blocks." + str(ub) + ".upsamplers.0.conv.weight")
            w_up_b, _ := st_tensor("decoder.up_blocks." + str(ub) + ".upsamplers.0.conv.bias")
            up_out := alloc(out_ch * up_h * up_w * 4)
            conv2d(up_out, upsampled, w_up_w, w_up_b, out_ch, out_ch, up_h, up_w, 3, 3, 1, 1)
            free(upsampled)
            free(x)
            x = up_out
            h = up_h
            w = up_w
        }
        ub = ub + 1
    }

    // conv_norm_out + conv_out
    w_cno_w, _ := st_tensor("decoder.conv_norm_out.weight")
    w_cno_b, _ := st_tensor("decoder.conv_norm_out.bias")
    normed := alloc(128 * h * w * 4)
    group_norm_silu_f32(normed, x, w_cno_w, w_cno_b, 128, h, w, 32, 0.000001)
    free(x)

    w_cout_w, _ := st_tensor("decoder.conv_out.weight")
    w_cout_b, _ := st_tensor("decoder.conv_out.bias")
    image = alloc(3 * h * w * 4)
    conv2d(image, normed, w_cout_w, w_cout_b, 128, 3, h, w, 3, 3, 1, 1)
    free(normed)
    ocl_sync()
    println("  VAE: " + str(now_ms() - vt0) + "ms")
    flush()
    return
}

// VAE decoder forward pass
// latent: [4, 64, 64] → image: [3, 512, 512]
func vae_decode(latent) (image) {
    h := 64
    w := 64
    vt0 := now_ms()

    // post_quant_conv: Conv2d(4, 4, 1)
    w_pqc_w, _ := st_tensor("post_quant_conv.weight")
    w_pqc_b, _ := st_tensor("post_quant_conv.bias")
    x := alloc(4 * h * w * 4)
    conv2d(x, latent, w_pqc_w, w_pqc_b, 4, 4, h, w, 1, 1, 0, 1)

    // decoder.conv_in: Conv2d(4, 512, 3, pad=1)
    w_cin_w, _ := st_tensor("decoder.conv_in.weight")
    w_cin_b, _ := st_tensor("decoder.conv_in.bias")
    x2 := alloc(512 * h * w * 4)
    conv2d(x2, x, w_cin_w, w_cin_b, 4, 512, h, w, 3, 3, 1, 1)
    free(x)
    x = x2
    vt_conv_in := now_ms() - vt0
    println("  vae conv_in: " + str(vt_conv_in) + "ms")
    flush()

    // mid_block: resnet_0 + attention + resnet_1
    println("  vae mid_block...")
    flush()
    vt1 := now_ms()
    mid0 := alloc(512 * h * w * 4)
    vae_resnet_block(mid0, x, "decoder.mid_block.resnets.0", 512, 512, h, w)
    free(x)
    x = mid0

    mid_att := alloc(512 * h * w * 4)
    vae_attention(mid_att, x, "decoder.mid_block.attentions.0", 512, h, w)
    free(x)
    x = mid_att

    mid1 := alloc(512 * h * w * 4)
    vae_resnet_block(mid1, x, "decoder.mid_block.resnets.1", 512, 512, h, w)
    free(x)
    x = mid1
    vt_mid := now_ms() - vt1
    println("  vae mid_block done: " + str(vt_mid) + "ms")
    flush()

    // up_blocks: 0(512→512, up), 1(512→512, up), 2(512→256, up), 3(256→128, no up)
    vt2 := now_ms()
    ub := 0
    while ub < 4 {
        println("  vae up_block " + str(ub) + " (h=" + str(h) + ")")
        flush()
        out_ch := vae_channels[ub]
        in_ch := 0
        if ub == 0 { in_ch = 512 }
        if ub == 1 { in_ch = 512 }
        if ub == 2 { in_ch = 512 }
        if ub == 3 { in_ch = 256 }

        // 3 resnets per up block
        l := 0
        while l < 3 {
            // First resnet may change channels
            r_in := in_ch
            if l > 0 { r_in = out_ch }
            res_out := alloc(out_ch * h * w * 4)
            vae_resnet_block(res_out, x, "decoder.up_blocks." + str(ub) + ".resnets." + str(l), r_in, out_ch, h, w)
            free(x)
            x = res_out
            l = l + 1
        }

        // Upsampler (except last block)
        if ub < 3 {
            up_h := h * 2
            up_w := w * 2
            ocl_sync()
            upsampled := alloc(out_ch * up_h * up_w * 4)
            upsample_nearest(upsampled, x, out_ch, h, w)
            w_up_w, _ := st_tensor("decoder.up_blocks." + str(ub) + ".upsamplers.0.conv.weight")
            w_up_b, _ := st_tensor("decoder.up_blocks." + str(ub) + ".upsamplers.0.conv.bias")
            up_out := alloc(out_ch * up_h * up_w * 4)
            conv2d(up_out, upsampled, w_up_w, w_up_b, out_ch, out_ch, up_h, up_w, 3, 3, 1, 1)
            free(upsampled)
            free(x)
            x = up_out
            h = up_h
            w = up_w
        }
        ub = ub + 1
    }
    vt_up := now_ms() - vt2
    println("  vae up_blocks: " + str(vt_up) + "ms")
    flush()

    // conv_norm_out: GroupNorm(32, 128) + SiLU (fused GPU kernel)
    w_cno_w, _ := st_tensor("decoder.conv_norm_out.weight")
    w_cno_b, _ := st_tensor("decoder.conv_norm_out.bias")
    normed := alloc(128 * h * w * 4)
    group_norm_silu_f32(normed, x, w_cno_w, w_cno_b, 128, h, w, 32, 0.000001)
    free(x)

    // conv_out: Conv2d(128, 3, 3, pad=1)
    w_cout_w, _ := st_tensor("decoder.conv_out.weight")
    w_cout_b, _ := st_tensor("decoder.conv_out.bias")
    image = alloc(3 * h * w * 4)
    conv2d(image, normed, w_cout_w, w_cout_b, 128, 3, h, w, 3, 3, 1, 1)
    free(normed)
    ocl_sync()
    vt_out := now_ms() - vt0 - vt_conv_in - vt_mid - vt_up
    println("  vae conv_out: " + str(vt_out) + "ms")
    flush()
    return
}
